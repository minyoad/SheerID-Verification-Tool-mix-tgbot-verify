# Telegram Bot 配置
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
CHANNEL_USERNAME=your_channel
CHANNEL_URL=https://t.me/your_channel
ADMIN_USER_ID=123456789

# ===== 数据库配置 =====
# 数据库类型：sqlite（默认，零依赖，推荐）或 mysql
DB_TYPE=sqlite
# SQLite 数据库文件路径（docker-compose 中挂载到 /docker/sheerid/data）
SQLITE_PATH=/app/data/bot.db
# 本机直接运行时可用相对路径
# SQLITE_PATH=bot.db

# ===== MySQL 配置（仅当 DB_TYPE=mysql 时需要）=====
# 使用 docker-compose 时 HOST 填 mysql（服务名），单独运行填 localhost
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_USER=tgbot_user
# MYSQL_PASSWORD=your_password_here
# MYSQL_DATABASE=tgbot_verify
# docker-compose 中 mysql 容器的 root 密码
# MYSQL_ROOT_PASSWORD=root_password

# 积分配置（可选，默认值在 config.py 中）
# VERIFY_COST=1
# CHECKIN_REWARD=1
# INVITE_REWARD=2
# REGISTER_REWARD=1
