# Telegram Bot 配置
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
CHANNEL_USERNAME=your_channel
CHANNEL_URL=https://t.me/your_channel
ADMIN_USER_ID=123456789

# ===== 数据库配置 =====
# 数据库类型：sqlite（默认，零依赖，推荐）或 mysql
DB_TYPE=sqlite
# SQLite 数据库文件路径（docker-compose 中挂载到 /docker/sheerid/data）
SQLITE_PATH=/app/data/bot.db
# 本机直接运行时可用相对路径
# SQLITE_PATH=bot.db

# ===== MySQL 配置（仅当 DB_TYPE=mysql 时需要）=====
# 使用 docker-compose 时 HOST 填 mysql（服务名），单独运行填 localhost
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_USER=tgbot_user
# MYSQL_PASSWORD=your_password_here
# MYSQL_DATABASE=tgbot_verify
# docker-compose 中 mysql 容器的 root 密码
# MYSQL_ROOT_PASSWORD=root_password

# 积分配置（可选，默认值在 config.py 中）
# VERIFY_COST=1
# CHECKIN_REWARD=1
# INVITE_REWARD=2
# REGISTER_REWARD=1

# ===== Turnstile 验证码配置（SheerID 人机验证）=====
# 是否无头模式获取 token，默认 true。
# 若 headless 被 Cloudflare 拦截，可设 false 用有头模式（容器内需用 xvfb-run 启动进程）：
#   docker compose exec tgbot xvfb-run -a python -u bot.py
# 无 DISPLAY 时即使设 false 也会自动回退 headless，不会报错。
# CAPTCHA_HEADLESS=true
# 强制有头模式（跳过 DISPLAY 检测，需自行保证 X server/xvfb 可用）
# CAPTCHA_FORCE_HEADED=false
# 第三方打码服务兜底（Playwright 失败后自动调用，二选一配置即可）
# CAPSOLVER_API_KEY=
# 2CAPTCHA_API_KEY=
